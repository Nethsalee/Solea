# Keep your existing NEXT_PUBLIC_FIREBASE_* login settings.
# Add these SERVER settings to .env.local (not to client variables).
FIREBASE_ADMIN_PROJECT_ID=your_existing_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/USER/Desktop/E Commerce/.secrets/firebase-admin.json
# Start in local mode; switch after creating Firestore and importing products.
CATALOG_SOURCE=local

# Hosting alternative to a credentials file (do not use NEXT_PUBLIC_ prefixes):
# FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
